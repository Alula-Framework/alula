ice"},{"text":", the runtime load path no longer goes through","type":"text"},{"text":" ","type":"text"},{"text":"this type: ","type":"text"},{"code":"ConfigurationLoader","type":"codeVoice"},{"text":" builds swift-configuration’s own","type":"text"},{"text":" ","type":"text"},{"code":"EnvironmentVariablesProvider","type":"codeVoice"},{"text":" instead. What survives here, and is still","type":"text"},{"text":" ","type":"text"},{"text":"load-bearing, is ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AlulaConfigCore\/documentation\/AlulaConfigCore\/EnvironmentVariablesSource\/variableName(for:)","type":"reference"},{"text":" — the key-to-variable transform,","type":"text"},{"text":" ","type":"text"},{"text":"which ","type":"text"},{"code":"ConfigError.missingKey","type":"codeVoice"},{"text":" uses to tell an operator which variable to","type":"text"},{"text":" ","type":"text"},{"text":"set, and which the build plugin uses for the same reason.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Keys map to variable names via a fixed transform: uppercase, ","type":"text"},{"code":".","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"_","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"prefixed ","type":"text"},{"code":"ALULA_","type":"codeVoice"},{"text":". So ","type":"text"},{"code":"datasource.url","type":"codeVoice"},{"text":" reads ","type":"text"},{"code":"ALULA_DATASOURCE_URL","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"datasource.pool_size","type":"codeVoice"},{"text":" reads ","type":"text"},{"code":"ALULA_DATASOURCE_POOL_SIZE","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two consequences of the transform being fixed and one-way:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Config keys should stick to lowercase letters, digits, underscores, and"},{"type":"text","text":" "},{"type":"text","text":"dots — anything else (dashes, say) produces a variable name most shells"},{"type":"text","text":" "},{"type":"text","text":"cannot set."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The transform is not injective: "},{"type":"codeVoice","code":"datasource.pool_size"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"datasource.pool.size"},{"type":"text","text":" both read "},{"type":"codeVoice","code":"ALULA_DATASOURCE_POOL_SIZE"},{"type":"text","text":". Spring’s"},{"type":"text","text":" "},{"type":"text","text":"relaxed binding has the same property; don’t define config keys that"},{"type":"text","text":" "},{"type":"text","text":"collide under it."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The process environment is snapshotted at ","type":"text"},{"code":"init","type":"codeVoice"},{"text":" — the source never","type":"text"},{"text":" ","type":"text"},{"text":"re-reads ","type":"text"},{"code":"ProcessInfo","type":"codeVoice"},{"text":" afterwards, preserving ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"immutability guarantee even if something else mutates the","type":"text"},{"text":" ","type":"text"},{"text":"environment mid-alula.","type":"text"}]}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AlulaConfigCore\/documentation\/AlulaConfigCore\/EnvironmentVariablesSource"},"abstract":[{"type":"text","text":"The environment-variable layer — precedence layer 1, the layer that always"},{"type":"text","text":" "},{"type":"text","text":"wins. It is the standard “override anything at deploy time” escape"},{"type":"text","text":" "},{"type":"text","text":"hatch: container orchestrators, CI secrets, one-off local overrides."}],"seeAlsoSections":[{"identifiers":["doc:\/\/AlulaCo