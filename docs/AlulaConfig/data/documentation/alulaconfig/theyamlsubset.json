{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full YAML is a large language with several ways to write the same thing and a"},{"type":"text","text":" "},{"type":"text","text":"few famous ways to write something you did not mean. A configuration file"},{"type":"text","text":" "},{"type":"text","text":"does not need that surface — it needs to be unambiguous."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So this parser accepts a deliberately small subset, and rejects everything"},{"type":"text","text":" "},{"type":"text","text":"else with a message naming the construct and the alternative. Anything it"},{"type":"text","text":" "},{"type":"text","text":"does not fully understand is a loud failure at load, never a value that means"},{"type":"text","text":" "},{"type":"text","text":"something unexpected at runtime."}]},{"level":2,"type":"heading","text":"What is supported","anchor":"What-is-supported"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Nested maps","type":"text"}],"type":"strong"},{"text":", to any depth:","type":"text"}]},{"syntax":"yaml","code":["server:","  http:","    port: 8080","    host: 0.0.0.0"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Keys flatten with dots: ","type":"text"},{"code":"server.http.port","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Sequences"}],"type":"strong"},{"type":"text","text":", addressed by index:"}]},{"syntax":"yaml","code":["cluster:","  hosts:","    - alpha","    - beta"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Flattens to ","type":"text"},{"type":"codeVoice","code":"cluster.hosts.0"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"cluster.hosts.1"},{"text":". Read the whole array","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration\/reader"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Scalars"}],"type":"strong"},{"text":" — strings, integers, doubles, booleans — quoted or bare:","type":"text"}]},{"syntax":"yaml","code":["name: my-app","port: 8080","ratio: 0.75","debug: false","quoted: \"value: with a colon\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Comments"}],"type":"strong"},{"text":", whole-line or trailing:","type":"text"}]},{"syntax":"yaml","code":["# The port the server binds","port: 8080          # overridden by ALULA_SERVER_PORT"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"${VAR}"},{"text":" substitution","type":"text"}]},{"type":"text","text":" — see "},{"type":"reference","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/SecretsAndSubstitution","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"What is rejected, and what to use instead","anchor":"What-is-rejected-and-what-to-use-instead"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Construct","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Why"}]}],[{"type":"paragraph","inlineContent":[{"text":"Instead","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Flow style — ","type":"text"},{"code":"[a, b]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"{k: v}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Two syntaxes for one structure; the braces also collide visually with "},{"code":"${VAR}","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Block style"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Block scalars — ","type":"text"},{"code":"|","type":"codeVoice"},{"text":", ","type":"text"},{"code":">","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Folding rules are subtle and rarely what the author pictured"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A quoted string"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Anchors and aliases — ","type":"text"},{"code":"&x","type":"codeVoice"},{"text":", ","type":"text"},{"code":"*x","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Indirection in a file whose job is to be read at a glance"}]}],[{"type":"paragraph","inlineContent":[{"text":"Repeat the value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiple documents — "},{"type":"codeVoice","code":"---"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One file, one configuration"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate files"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tags — "},{"code":"!!str","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Types come from the Swift side"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quote it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Reserved indicators — ","type":"text"},{"type":"codeVoice","code":"@"},{"text":" and backtick","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Reserved by the YAML spec for future use, so they mean nothing today","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quote it"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"Each rejection names the line and column:","type":"text"}]},{"syntax":null,"code":["alula.yaml:4:3: flow style ('[…]' \/ '{…}') is not supported by the Alula","YAML subset — quote the value if the character is literal"],"type":"codeListing"},{"level":2,"type":"heading","text":"Robustness","anchor":"Robustness"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A UTF-8 BOM is stripped."}]},{"type":"text","text":" Windows editors write one by default, and it is"},{"type":"text","text":" "},{"type":"text","text":"invisible. Left in place it would become part of the first key — so"},{"type":"text","text":" "},{"type":"codeVoice","code":"server.port"},{"type":"text","text":" would parse as "},{"type":"codeVoice","code":"\\u{FEFF}server.port"},{"type":"text","text":" and every lookup for it"},{"type":"text","text":" "},{"type":"text","text":"would report the key missing, from a file that visibly contains it."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"All three line endings work."}]},{"type":"text","text":" LF, CRLF, and CR all separate lines, so a"},{"type":"text","text":" "},{"type":"text","text":"file edited on Windows and one edited on Linux parse identically."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Duplicate keys are rejected","type":"text"}]},{"text":", rather than last-one-winning silently.","type":"text"}]},{"level":2,"type":"heading","text":"Reading a file yourself","anchor":"Reading-a-file-yourself"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AlulaYAMLDocument"},{"text":" is the parser, usable directly:","type":"text"}]},{"syntax":"swift","code":["let document = try AlulaYAMLDocument(contentsOf: url)","document.keys                       \/\/ every flattened key","document.rawValue(for: \"server.port\")   \/\/ \"8080\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This is also what build tooling uses to check configuration keys at compile","type":"text"},{"text":" ","type":"text"},{"text":"time — it lives in the dependency-free core module for exactly that reason.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/TheYAMLSubset"},"sections":[],"kind":"article","metadata":{"modules":[{"name":"AlulaConfig"}],"roleHeading":"Article","role":"article","title":"The YAML subset"},"abstract":[{"type":"text","text":"What the parser accepts, what it refuses, and why the refusals are the"},{"type":"text","text":" "},{"type":"text","text":"point."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/alulaconfig\/theyamlsubset"]}],"hierarchy":{"paths":[["doc:\/\/AlulaConfig\/documentation\/AlulaConfig"]]},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/LayeringAndPrecedence","doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/SecretsAndSubstitution"],"title":"Guides","generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://AlulaConfig/documentation/AlulaConfig/Configuration/reader":{"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration\/reader","abstract":[{"type":"text","text":"This configuration as a swift-configuration "},{"type":"codeVoice","code":"ConfigReader"},{"type":"text","text":"."}],"kind":"symbol","title":"reader","url":"\/documentation\/alulaconfig\/configuration\/reader","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ConfigReader","kind":"typeIdentifier","preciseIdentifier":"s:13Configuration12ConfigReaderV"}]},"doc://AlulaConfig/documentation/AlulaConfig":{"abstract":[{"text":"Layered, environment-aware configuration that fails at startup, not at","type":"text"},{"text":" ","type":"text"},{"text":"request time.","type":"text"}],"kind":"symbol","title":"AlulaConfig","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig","url":"\/documentation\/alulaconfig","type":"topic","role":"collection"},"doc://AlulaConfig/documentation/AlulaConfig/LayeringAndPrecedence":{"kind":"article","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/LayeringAndPrecedence","abstract":[{"text":"How three sources resolve into one value, and what happens when they","type":"text"},{"text":" ","type":"text"},{"text":"disagree.","type":"text"}],"type":"topic","title":"Layering and precedence","url":"\/documentation\/alulaconfig\/layeringandprecedence","role":"article"},"doc://AlulaConfig/documentation/AlulaConfig/SecretsAndSubstitution":{"kind":"article","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/SecretsAndSubstitution","abstract":[{"text":"Pulling values from the environment, and keeping them out of your logs.","type":"text"}],"type":"topic","title":"Secrets and substitution","url":"\/documentation\/alulaconfig\/secretsandsubstitution","role":"article"}}}