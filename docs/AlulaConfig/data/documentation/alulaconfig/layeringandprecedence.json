{"abstract":[{"text":"How three sources resolve into one value, and what happens when they","type":"text"},{"text":" ","type":"text"},{"text":"disagree.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/LayeringAndPrecedence"},"metadata":{"modules":[{"name":"AlulaConfig"}],"roleHeading":"Article","title":"Layering and precedence","role":"article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/AlulaConfig\/documentation\/AlulaConfig"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/alulaconfig\/layeringandprecedence"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configuration resolves highest precedence first:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Layer"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Source"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What belongs here"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Custom providers","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"additionalProviders:"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Remote stores, secret managers — above everything else when supplied","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Environment variables"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ALULA_SERVER_PORT","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Deployment overrides, secrets"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Environment overlay"}],"type":"paragraph"}],[{"inlineContent":[{"code":"alula-{env}.yaml","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What differs per environment"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Base"}],"type":"paragraph"}],[{"inlineContent":[{"code":"alula.yaml","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Defaults that hold everywhere"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"code":"alula.yaml","type":"codeVoice"},{"type":"text","text":" must exist — it is the file that defines what keys your"},{"type":"text","text":" "},{"type":"text","text":"application has. The overlay is optional."}]},{"code":["# alula.yaml — the defaults","server:","  port: 8080","datasource:","  url: postgres:\/\/localhost\/app_dev","  pool_size: 5"],"type":"codeListing","syntax":"yaml"},{"code":["# alula-prod.yaml — only what changes","datasource:","  url: \"${DATABASE_URL}\"","  pool_size: 50"],"type":"codeListing","syntax":"yaml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In production, "},{"type":"codeVoice","code":"server.port"},{"type":"text","text":" resolves to "},{"type":"codeVoice","code":"8080"},{"type":"text","text":" from the base file, while"},{"type":"text","text":" "},{"type":"codeVoice","code":"datasource.pool_size"},{"type":"text","text":" resolves to "},{"type":"codeVoice","code":"50"},{"type":"text","text":" from the overlay. Nothing needs"},{"type":"text","text":" "},{"type":"text","text":"restating in the overlay just to keep it."}]},{"type":"heading","level":2,"anchor":"Environment-variables","text":"Environment variables"},{"type":"paragraph","inlineContent":[{"text":"A dotted key becomes an upper-snake-case variable with a ","type":"text"},{"type":"codeVoice","code":"ALULA_"},{"text":" prefix:","type":"text"}]},{"code":["server.port           →  ALULA_SERVER_PORT","datasource.pool_size  →  ALULA_DATASOURCE_POOL_SIZE"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Setting one overrides both files. This is how a deployment platform injects"},{"type":"text","text":" "},{"type":"text","text":"values without a configuration change, and it is where secrets belong."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ALULA_"},{"type":"text","text":" is "},{"type":"codeVoice","code":"ConfigPrefix.default"},{"type":"text","text":", and the file names come from the"},{"type":"text","text":" "},{"type":"text","text":"same word. An application that needs another namespace — two Alula services"},{"type":"text","text":" "},{"type":"text","text":"sharing a container, or a platform that already injects "},{"type":"codeVoice","code":"ALULA_*"},{"type":"text","text":" — passes"},{"type":"text","text":" "},{"type":"text","text":"its own, and all four spellings follow together:"}]},{"code":["let configuration = try Configuration.load(prefix: \"myapp\")","\/\/ myapp.yaml, myapp-prod.yaml, MYAPP_ENV, MYAPP_SERVER_PORT"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"The-rule-that-makes-layering-safe","text":"The rule that makes layering safe"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A key found in a higher layer wins. A key "},{"inlineContent":[{"text":"absent","type":"text"}],"type":"emphasis"},{"type":"text","text":" from a higher layer falls"},{"type":"text","text":" "},{"type":"text","text":"through. Those two are obvious. The third case is the one that matters:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A layer that holds the key but cannot answer the request stops the walk."}]}]},{"code":["# alula-prod.yaml","cluster:","  hosts:","    - alpha","    - beta"],"type":"codeListing","syntax":"yaml"},{"code":["try configuration.get(\"cluster.hosts\", as: String.self)","\/\/ throws ConfigError.unrepresentableValue —","\/\/ \"present in alula-prod.yaml as an array of strings\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It would be easy to treat “I cannot render this as a string” as “not here”"},{"type":"text","text":" "},{"type":"text","text":"and continue to the next layer. That is precisely what must not happen: the"},{"type":"text","text":" "},{"type":"text","text":"next layer is the development file, and answering from it would silently give"},{"type":"text","text":" "},{"type":"text","text":"a production deployment a development value. So resolution stops and reports"},{"type":"text","text":" "},{"type":"text","text":"what it found, where it found it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read those values through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration\/reader"},{"type":"text","text":" and ask for the array type"},{"type":"text","text":" "},{"type":"text","text":"directly:"}]},{"code":["configuration.reader.stringArray(forKey: \"cluster.hosts\")   \/\/ [\"alpha\", \"beta\"]"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"Environments","text":"Environments"},{"type":"paragraph","inlineContent":[{"code":"AlulaEnvironment.current","type":"codeVoice"},{"type":"text","text":" reads "},{"code":"ALULA_ENV","type":"codeVoice"},{"type":"text","text":". Unset means"},{"type":"text","text":" "},{"code":"AlulaEnvironment.dev","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Four environments ship with the package, but the type is extensible:","type":"text"}]},{"code":["extension AlulaEnvironment {","    static let qa = AlulaEnvironment(\"qa\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value that is not one of the built-ins resolves to itself. "},{"type":"codeVoice","code":"ALULA_ENV=qa"},{"type":"text","text":" "},{"type":"text","text":"looks for "},{"type":"codeVoice","code":"alula-qa.yaml"},{"type":"text","text":" — it does not quietly become "},{"type":"codeVoice","code":"dev"},{"type":"text","text":", because"},{"type":"text","text":" "},{"type":"text","text":"loading development configuration under a production-shaped name is the"},{"type":"text","text":" "},{"type":"text","text":"failure mode this library is organized around preventing."}]},{"type":"heading","level":2,"anchor":"Custom-providers","text":"Custom providers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Anything conforming to swift-configuration’s "},{"type":"codeVoice","code":"ConfigProvider"},{"type":"text","text":" layers in"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"above everything else","type":"text"}]},{"type":"text","text":". "},{"type":"codeVoice","code":"additionalProviders"},{"type":"text","text":" is inserted above the"},{"type":"text","text":" "},{"type":"text","text":"env-var layer so it wins; there is no parameter for placing one lower:"}]},{"code":["let configuration = try Configuration.load(","    additionalProviders: [remoteSecretsProvider]",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the seam for remote configuration, secret managers, and anything else","type":"text"},{"text":" ","type":"text"},{"text":"this package deliberately does not implement.","type":"text"}]},{"type":"heading","level":2,"anchor":"Inspecting-a-resolved-stack","text":"Inspecting a resolved stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a key resolved to something surprising, the question is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"which layer"},{"type":"text","text":" "},{"type":"text","text":"said so"}]},{"type":"text","text":":"}]},{"code":["print(configuration)","\/\/ Configuration (environment: prod), 3 providers, highest precedence first:","\/\/   1. EnvironmentVariables[12 values]","\/\/   2. AlulaYAML[alula-prod.yaml, 4 keys]","\/\/   3. AlulaYAML[alula.yaml, 18 keys]"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration\/description","type":"reference"},{"text":" names the layers without printing values, so it","type":"text"},{"text":" ","type":"text"},{"text":"is safe to log unconditionally. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration\/debugDescription","type":"reference"},{"text":" adds the","type":"text"},{"text":" ","type":"text"},{"text":"values, with secrets redacted — see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/SecretsAndSubstitution","type":"reference"},{"text":".","type":"text"}]}]}],"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/TheYAMLSubset","doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/SecretsAndSubstitution"],"anchor":"Guides"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://AlulaConfig/documentation/AlulaConfig/Configuration/reader":{"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration\/reader","abstract":[{"type":"text","text":"This configuration as a swift-configuration "},{"type":"codeVoice","code":"ConfigReader"},{"type":"text","text":"."}],"kind":"symbol","title":"reader","url":"\/documentation\/alulaconfig\/configuration\/reader","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reader","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ConfigReader","kind":"typeIdentifier","preciseIdentifier":"s:13Configuration12ConfigReaderV"}]},"doc://AlulaConfig/documentation/AlulaConfig/Configuration/debugDescription":{"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration\/debugDescription","abstract":[{"text":"The provider stack ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"with","type":"text"}]},{"text":" the values each layer h