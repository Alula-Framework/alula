{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Configuration goes wrong in one of two ways. Either a value is missing, or a","type":"text"},{"text":" ","type":"text"},{"text":"value is present and means something you did not intend. The second is worse,","type":"text"},{"text":" ","type":"text"},{"text":"because it does not announce itself — a service comes up, serves traffic, and","type":"text"},{"text":" ","type":"text"},{"text":"resolves a production key from a development file.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This library is built around making both loud, and making them loud at","type":"text"},{"text":" ","type":"text"},{"text":"startup:","type":"text"}]},{"code":["let configuration = try Configuration.load()","","let port: Int = try configuration.get(\"server.port\")","let poolSize = configuration.get(\"datasource.pool_size\", default: 10)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three layers resolve in precedence order — environment variables, then"},{"type":"text","text":" "},{"type":"codeVoice","code":"alula-{env}.yaml"},{"type":"text","text":", then "},{"type":"codeVoice","code":"alula.yaml"},{"type":"text","text":" — and a key found in a higher layer"},{"type":"text","text":" "},{"type":"text","text":"wins outright. What makes that safe is the rule underneath it: a layer that"},{"type":"text","text":" "},{"type":"text","text":"holds a key but cannot answer the request "},{"inlineContent":[{"text":"stops the walk","type":"text"}],"type":"strong"},{"type":"text","text":" rather than"},{"type":"text","text":" "},{"type":"text","text":"letting resolution continue downward. Falling through would answer a"},{"type":"text","text":" "},{"type":"text","text":"production key from a development layer without saying so."}]},{"type":"heading","level":2,"anchor":"Two-modules","text":"Two modules"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig","isActive":true},{"type":"text","text":" is the runtime: the "},{"type":"reference","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration","isActive":true},{"type":"text","text":" facade, the loader,"},{"type":"text","text":" "},{"type":"text","text":"and the swift-configuration bridge. Applications import this."}]},{"type":"paragraph","inlineContent":[{"code":"AlulaConfigCore","type":"codeVoice"},{"type":"text","text":" is the grammar and vocabulary — the YAML parser, "},{"code":"${VAR}","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"substitution, "},{"code":"ConfigDecodable","type":"codeVoice"},{"type":"text","text":", the error types, "},{"code":"AlulaEnvironment","type":"codeVoice"},{"type":"text","text":". It"},{"type":"text","text":" "},{"type":"text","text":"has no dependencies, deliberately, because build tools link it to check"},{"type":"text","text":" "},{"type":"text","text":"configuration keys at compile time and a build tool’s dependencies are paid"},{"type":"text","text":" "},{"type":"text","text":"for by every consumer’s build."}]},{"type":"paragraph","inlineContent":[{"text":"Importing ","type":"text"},{"isActive":true,"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig","type":"reference"},{"text":" re-exports the core, so one import gives you","type":"text"},{"text":" ","type":"text"},{"text":"everything.","type":"text"}]}]}],"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration"],"anchor":"Essentials"},{"title":"Providers","identifiers":["doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/AlulaYAMLProvider","doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/AlulaYAMLSnapshot"],"anchor":"Providers"},{"title":"Guides","identifiers":["doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/LayeringAndPrecedence","doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/TheYAMLSubset","doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/SecretsAndSubstitution"],"anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/alulaconfig"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig"},"sections":[],"metadata":{"symbolKind":"module","modules":[{"name":"AlulaConfig"}],"roleHeading":"Framework","role":"collection","title":"AlulaConfig","externalID":"AlulaConfig"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Layered, environment-aware configuration that fails at startup, not at"},{"type":"text","text":" "},{"type":"text","text":"request time."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://AlulaConfig/documentation/AlulaConfig/LayeringAndPrecedence":{"kind":"article","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/LayeringAndPrecedence","abstract":[{"text":"How three sources resolve into one value, and what happens when they","type":"text"},{"text":" ","type":"text"},{"text":"disagree.","type":"text"}],"type":"topic","title":"Layering and precedence","url":"\/documentation\/alulaconfig\/layeringandprecedence","role":"article"},"doc://AlulaConfig/documentation/AlulaConfig/TheYAMLSubset":{"abstract":[{"text":"What the parser accepts, what it refuses, and why the refusals are the","type":"text"},{"text":" ","type":"text"},{"text":"point.","type":"text"}],"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/TheYAMLSubset","kind":"article","title":"The YAML subset","url":"\/documentation\/alulaconfig\/theyamlsubset","type":"topic","role":"article"},"doc://AlulaConfig/documentation/AlulaConfig/AlulaYAMLSnapshot":{"type":"topic","url":"\/documentation\/alulaconfig\/alulayamlsnapshot","kind":"symbol","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/AlulaYAMLSnapshot","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AlulaYAMLSnapshot"}],"abstract":[{"text":"Alula-subset YAML as a swift-configuration snapshot.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AlulaYAMLSnapshot"}],"role":"symbol","title":"AlulaYAMLSnapshot"},"doc://AlulaConfig/documentation/AlulaConfig":{"abstract":[{"text":"Layered, environment-aware configuration that fails at startup, not at","type":"text"},{"text":" ","type":"text"},{"text":"request time.","type":"text"}],"kind":"symbol","title":"AlulaConfig","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig","url":"\/documentation\/alulaconfig","type":"topic","role":"collection"},"doc://AlulaConfig/documentation/AlulaConfig/SecretsAndSubstitution":{"kind":"article","identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/SecretsAndSubstitution","abstract":[{"text":"Pulling values from the environment, and keeping them out of your logs.","type":"text"}],"type":"topic","title":"Secrets and substitution","url":"\/documentation\/alulaconfig\/secretsandsubstitution","role":"article"},"doc://AlulaConfig/documentation/AlulaConfig/AlulaYAMLProvider":{"abstract":[{"type":"text","text":"Serves one already-parsed "},{"type":"codeVoice","code":"AlulaYAMLSnapshot"},{"type":"text","text":"."}],"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/AlulaYAMLProvider","kind":"symbol","title":"AlulaYAMLProvider","url":"\/documentation\/alulaconfig\/alulayamlprovider","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AlulaYAMLProvider"}],"navigatorTitle":[{"kind":"identifier","text":"AlulaYAMLProvider"}]},"doc://AlulaConfig/documentation/AlulaConfig/Configuration":{"abstract":[{"text":"Immutable, fully-resolved configuration. Built once at bootstrap, handed","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"Alula.bootstrap","type":"codeVoice"},{"text":", never mutated after.","type":"text"}],"identifier":"doc:\/\/AlulaConfig\/documentation\/AlulaConfig\/Configuration","kind":"symbol","title":"Configuration","url":"\/documentation\/alulaconfig\/configuration","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Configuration"}],"navigatorTitle":[{"kind":"identifier","text":"Configuration"}]}}}