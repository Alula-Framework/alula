{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The one name every configuration spelling is derived from."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/AlulaConfigCore\/s8CopyableP","doc:\/\/AlulaConfigCore\/s23CustomStringConvertibleP","doc:\/\/AlulaConfigCore\/SQ","doc:\/\/AlulaConfigCore\/s9EscapableP","doc:\/\/AlulaConfigCore\/s43ExpressibleByExtendedGraphemeClusterLiteralP","doc:\/\/AlulaConfigCore\/s26ExpressibleByStringLiteralP","doc:\/\/AlulaConfigCore\/s33ExpressibleByUnicodeScalarLiteralP","doc:\/\/AlulaConfigCore\/SH","doc:\/\/AlulaConfigCore\/s8SendableP","doc:\/\/AlulaConfigCore\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConfigPrefix"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Alula’s defaults are ","type":"text"},{"code":"alula.yaml","type":"codeVoice"},{"text":", ","type":"text"},{"code":"alula-{env}.yaml","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ALULA_ENV","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"ALULA_SERVER_PORT","type":"codeVoice"},{"text":" — four spellings of the same word. This type holds","type":"text"},{"text":" ","type":"text"},{"text":"that word once and derives all four, so an application that needs a","type":"text"},{"text":" ","type":"text"},{"text":"different one changes it in a single place and cannot end up reading","type":"text"},{"text":" ","type":"text"},{"code":"myapp.yaml","type":"codeVoice"},{"text":" while looking for ","type":"text"},{"code":"ALULA_SERVER_PORT","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two reasons an application reaches for this:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Variable collisions."}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"ALULA_"},{"text":" is a short prefix in a shared","type":"text"},{"text":" ","type":"text"},{"text":"environment. Two Alula services in one container, or a platform that","type":"text"},{"text":" ","type":"text"},{"text":"already injects ","type":"text"},{"type":"codeVoice","code":"ALULA_*"},{"text":", need their own namespace.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Naming.","type":"text"}]},{"text":" A file called ","type":"text"},{"type":"codeVoice","code":"alula.yaml"},{"text":" in someone else’s repository","type":"text"},{"text":" ","type":"text"},{"text":"names the framework rather than the application.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"The-build-time-check-still-applies","level":2,"text":"The build-time check still applies","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ConfigValue"},{"type":"text","text":" keys without a "},{"type":"codeVoice","code":"default:"},{"type":"text","text":" are verified against the base file"},{"type":"text","text":" "},{"inlineContent":[{"text":"at build time","type":"text"}],"type":"emphasis"},{"type":"text","text":", and a custom prefix does not give that up. The prefix"},{"type":"text","text":" "},{"type":"text","text":"looks like a runtime value because "},{"type":"codeVoice","code":"load"},{"type":"text","text":" takes it at runtime, but an"},{"type":"text","text":" "},{"type":"text","text":"application writes it as a literal in its own source — and that source is"},{"type":"text","text":" "},{"type":"text","text":"already scanned. "},{"type":"codeVoice","code":"alula-registration-gen"},{"type":"text","text":" reads the "},{"type":"codeVoice","code":"prefix:"},{"type":"text","text":" argument and"},{"type":"text","text":" "},{"type":"text","text":"checks against "},{"type":"codeVoice","code":"<prefix>.yaml"},{"type":"text","text":", exactly as it does for "},{"type":"codeVoice","code":"alula.yaml"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is discovered from the filesystem. An unscanned prefix means the","type":"text"},{"text":" ","type":"text"},{"text":"default name, never “whatever YAML is lying around” — file presence decides","type":"text"},{"text":" ","type":"text"},{"text":"nothing here.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two cases are not statically knowable, and both say so rather than passing"},{"type":"text","text":" "},{"type":"text","text":"quietly. An interpolated or computed prefix, and two literals that"},{"type":"text","text":" "},{"type":"text","text":"disagree, leave the base file unidentifiable: the build warns and those keys"},{"type":"text","text":" "},{"type":"text","text":"are verified at startup instead. A literal that is not a "},{"type":"emphasis","inlineContent":[{"text":"legal","type":"text"}]},{"type":"text","text":" prefix is a"},{"type":"text","text":" "},{"type":"text","text":"build error — "},{"type":"codeVoice","code":"Configuration.load"},{"type":"text","text":" would trap on it at startup, and the name"},{"type":"text","text":" "},{"type":"text","text":"is knowable here."}]}]}],"hierarchy":{"paths":[["doc:\/\/AlulaConfigCore\/documentation\/AlulaConfigCore"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/AlulaConfigCore\/documentation\/AlulaConfigCore\/ConfigPrefix"},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/AlulaConfigCore\/documentation\/AlulaConfigCore\/ConfigPrefix\/init(_:)","doc:\/\/AlulaConfigCore\/documentation\/AlulaConfigCore\/ConfigPrefix\/init(validating:)"],"anchor":"Initializers"},{"title":"Instance Properties","gener