// The system zlib, as a Swift module.
//
// A shim header rather than `header "/usr/include/zlib.h"` because that path
// is wrong on Darwin (the header lives in the active SDK) and on any Linux
// that puts it under an architecture triple. `#include <zlib.h>` lets the
// C preprocessor find it the way every other C program does.
module CFlightZlib [system] {
    header "shim.h"
    link "z"
    export *
}
